# ─── Midtrans ───────────────────────────────────────────────
# Ambil dari dashboard Midtrans: Settings → Access Keys
# Sandbox: https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ─── Checkout ───────────────────────────────────────────────
# Ongkir flat (Rupiah). 0 = gratis ongkir
SHIPPING_FEE=0
# Masa berlaku QR (menit)
QR_EXPIRY_MINUTES=15

# ─── Shipping (RajaOngkir Starter) ────────────────────────
# Daftar gratis di https://rajaongkir.com
RAJAONGKIR_API_KEY=your_rajaongkir_api_key_here

PORT=3000
